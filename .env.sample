# The indexer will listen for signers approved by this FID
TARGET_SIGNER_FID=

# SealedCast will approve signers with this FID
APP_FID=

# The mnemonic (seed phrase) of the wallet holds the APP_FID. This is the seed phrase given to you by warpcast
APP_MNEMONIC=

# WalletConnect project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_ID=

# Sponsored Farcaster sign-in and writes through Neynar
NEXT_PUBLIC_NEYNAR_CLIENT_ID=
NEYNAR_API_KEY=

# Public app URL and server-only AWS API origin
NEXT_PUBLIC_URL=
AWS_API_ORIGIN=

# SealedCast / iExec Nox on Ethereum Sepolia
SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
SEALED_CAST_REGISTRY_ADDRESS=
NEXT_PUBLIC_SEALED_CAST_REGISTRY_ADDRESS=
SEALED_CAST_RELAYER_PRIVATE_KEY=
SEALED_CAST_WALLET_VERIFIER_PRIVATE_KEY=
