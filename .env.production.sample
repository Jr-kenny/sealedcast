# Public HTTPS hostname for the AWS API, without a protocol
API_DOMAIN=api.example.com

# Persistent services
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-different-long-random-value

# Farcaster app identity
APP_FID=
APP_MNEMONIC=

# Public app configuration
NEXT_PUBLIC_FC_CLIENT_NAME=SealedCast
NEXT_PUBLIC_WALLETCONNECT_ID=
NEXT_PUBLIC_NEYNAR_CLIENT_ID=
NEYNAR_API_KEY=
NEXT_PUBLIC_URL=

# Discord qualification identity OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://example.com/api/auth/discord/callback
DISCORD_TOKEN_ENCRYPTION_KEY=
SEALED_IDENTITY_ENCRYPTION_KEY=

# Ethereum Sepolia and iExec Nox
SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
SEALED_CAST_REGISTRY_ADDRESS=
NEXT_PUBLIC_SEALED_CAST_REGISTRY_ADDRESS=
SEALED_CAST_RELAYER_PRIVATE_KEY=
SEALED_CAST_WALLET_VERIFIER_PRIVATE_KEY=

# Optional image upload credentials
NEXT_PUBLIC_IMGUR_CLIENT_ID=
IMGUR_CLIENT_SECRET=
